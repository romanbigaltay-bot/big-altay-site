@font-face {
  font-family: "Roboto";
  src: url("../fonts/Inter-Regular.eot");
  src: local("Inter Regular"), local("Inter-Regular"), url("../fonts/Inter-Regular.eot?#iefix") format("embedded-opentype"), url("../fonts/Inter-Regular.woff2") format("woff2"), url("../fonts/Inter-Regular.woff") format("woff"), url("../fonts/Inter-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
}

@font-face {
  font-family: "Tenor Sans";
  src: url("../fonts/tenorsans/TenorSans.eot");
  src: local("Tenor Sans"), local("TenorSans"), url("../fonts/tenorsans/TenorSans.eot?#iefix") format("embedded-opentype"), url("../fonts/tenorsans/TenorSans.woff2") format("woff2"), url("../fonts/tenorsans/TenorSans.woff") format("woff"), url("../fonts/tenorsans/TenorSans.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
}

@font-face {
  font-family: "Muller";
  src: url("../fonts/muller/MullerBold.eot");
  src: local("Muller Bold"), local("MullerBold"), url("../fonts/muller/MullerBold.eot?#iefix") format("embedded-opentype"), url("../fonts/muller/MullerBold.woff2") format("woff2"), url("../fonts/muller/MullerBold.woff") format("woff"), url("../fonts/muller/MullerBold.ttf") format("truetype");
  font-weight: bold;
  font-style: normal;
}

@font-face {
  font-family: "Muller";
  src: url("../fonts/muller/MullerLight.eot");
  src: local("Muller Light"), local("MullerLight"), url("../fonts/muller/MullerLight.eot?#iefix") format("embedded-opentype"), url("../fonts/muller/MullerLight.woff2") format("woff2"), url("../fonts/muller/MullerLight.woff") format("woff"), url("../fonts/muller/MullerLight.ttf") format("truetype");
  font-weight: 300;
  font-style: normal;
}

@font-face {
  font-family: "Muller";
  src: url("../fonts/muller/MullerRegular.eot");
  src: local("Muller Regular"), local("MullerRegular"), url("../fonts/muller/MullerRegular.eot?#iefix") format("embedded-opentype"), url("../fonts/muller/MullerRegular.woff2") format("woff2"), url("../fonts/muller/MullerRegular.woff") format("woff"), url("../fonts/muller/MullerRegular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
}

@font-face {
  font-family: "Muller";
  src: url("../fonts/muller/MullerMedium.eot");
  src: local("Muller Medium"), local("MullerMedium"), url("../fonts/muller/MullerMedium.eot?#iefix") format("embedded-opentype"), url("../fonts/muller/MullerMedium.woff2") format("woff2"), url("../fonts/muller/MullerMedium.woff") format("woff"), url("../fonts/muller/MullerMedium.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
}

@font-face {
  font-family: "Inter";
  src: url("../fonts/inter/Inter-Regular.eot");
  src: local("Inter Regular"), local("Inter-Regular"), url("../fonts/inter/Inter-Regular.eot?#iefix") format("embedded-opentype"), url("../fonts/inter/Inter-Regular.woff2") format("woff2"), url("../fonts/inter/Inter-Regular.woff") format("woff"), url("../fonts/inter/Inter-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
}

.container {
  --bs-gutter-x: 1.5rem;
  --bs-gutter-y: 0;
  width: 100%;
  padding-right: calc(var(--bs-gutter-x) * 0.5);
  padding-left: calc(var(--bs-gutter-x) * 0.5);
  margin-right: auto;
  margin-left: auto;
}

* {
  padding: 0;
  margin: 0;
  border: none;
}

*,
*::before,
*::after {
  -webkit-box-sizing: border-box;
  box-sizing: border-box;
}

a,
a:link,
a:visited {
  text-decoration: none;
}

a:hover {
  text-decoration: none;
}

aside,
nav,
footer,
header,
section,
main {
  display: block;
}

h1,
h2,
h3,
h4,
h5,
h6,
p {
  font-size: inherit;
  font-weight: inherit;
}

ul,
ul li {
  list-style: none;
}

img {
  vertical-align: top;
}

img,
svg {
  max-width: 100%;
  height: auto;
}

input,
textarea,
button,
select {
  font: inherit inherit;
  background: transparent;
  color: inherit;
}

input::-ms-clear {
  display: none;
}

button,
input[type=submit] {
  background: transparent;
  display: inline-block;
  -webkit-box-shadow: none;
  box-shadow: none;
  background: none;
  cursor: pointer;
}

input:focus,
input:active,
button:focus,
button:active {
  outline: none;
}

button::-moz-focus-inner {
  padding: 0;
  border: 0;
}

label {
  cursor: pointer;
}

legend {
  display: block;
}

input,
textarea,
input:active,
textarea:active,
select {
  outline: none !important;
}

input[type=checkbox]:focus,
input[type=radio]:focus {
  visibility: hidden;
}

.footer {
  padding: 78px 0 96px 0;
  border-top: 1px solid #9BADC2;
  margin-top: 120px;
}

.footer__container {
  display: grid;
  grid-template-columns: 4fr 3fr 3fr 210px;
  -webkit-box-pack: justify;
  -ms-flex-pack: justify;
  justify-content: space-between;
  gap: 20px;
  grid-template-areas: "one two three four";
}

.footer-column:nth-child(1) {
  grid-area: one;
}

.footer-column:nth-child(2) {
  grid-area: two;
}

.footer-column:nth-child(3) {
  grid-area: three;
}

.footer-column:nth-child(4) {
  grid-area: four;
}

.footer-column:nth-child(5) {
  grid-area: five;
  display: none;
}

.footer-column__logo {
  margin-bottom: 20px;
}

.footer-column__copyright {
  font-style: normal;
  font-weight: 400;
  font-size: 15px;
  margin-bottom: 23px;
}

.footer-column__privacy {
  font-style: normal;
  font-weight: 400;
  font-size: 14px;
}

.footer-column__socials {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-column-gap: 25px;
  -moz-column-gap: 25px;
  column-gap: 25px;
  -webkit-box-pack: end;
  -ms-flex-pack: end;
  justify-content: end;
}

.footer-column__social-img {
  width: 30px;
  height: 30px;
}

.footer-column:last-child {
  text-align: right;
}

.footer-column-menu__item {
  font-style: normal;
  font-weight: 400;
  font-size: 16px;
  margin-bottom: 28px;
}

.footer-column-menu__item:last-child {
  margin-bottom: 0;
}

.footer-column-menu__link br {
  display: none;
}

.footer-contacts__link {
  display: -webkit-inline-box;
  display: -ms-inline-flexbox;
  display: inline-flex;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  margin-bottom: 25px;
}

.footer-contacts__title {
  font-style: normal;
  font-weight: 700;
  font-size: 18px;
  line-height: 18px;
  color: #303441;
  margin-left: 12px;
}

.footer-contacts__address {
  font-style: normal;
  font-weight: 400;
  font-size: 16px;
  line-height: 30px;
  margin-bottom: 35px;
  text-align: right;
}

.header {
  padding: 14px 0 6px 0;
  margin-bottom: 24px;
  position: relative;
  z-index: 999;
}

.header.sticky {
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 999;
  border-bottom: 1px solid #E2F1F7;
  padding-bottom: 15px;
  -webkit-transition: padding-bottom 0.1s ease-in-out;
  -o-transition: padding-bottom 0.1s ease-in-out;
  transition: padding-bottom 0.1s ease-in-out;
}

.header__container {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: justify;
  -ms-flex-pack: justify;
  justify-content: space-between;
  -webkit-box-align: start;
  -ms-flex-align: start;
  align-items: start;
  -webkit-column-gap: 40px;
  -moz-column-gap: 40px;
  column-gap: 40px;
}

.header-logo {
  -webkit-box-flex: 173px;
  -ms-flex: 173px 0 0px;
  flex: 173px 0 0;
}

.header-logo__img {
  width: 100%;
  -webkit-transition: 0.4s all ease-in-out;
  -o-transition: 0.4s all ease-in-out;
  transition: 0.4s all ease-in-out;
}

.header-wrapper {
  -webkit-box-flex: 100%;
  -ms-flex: 100% 1 1;
  flex: 100% 1 1;
}

.header-primary {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: end;
  -ms-flex-pack: end;
  justify-content: end;
  margin-bottom: 16px;
  padding-top: 14px;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
}

.header-primary-item {
  margin-right: 6%;
}

.header-primary-item__link {
  display: -webkit-inline-box;
  display: -ms-inline-flexbox;
  display: inline-flex;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
}

.header-primary-item__icon {
  -webkit-box-flex: 1;
  -ms-flex: auto 0 0px;
  flex: auto 0 0;
}

.header-primary-item__title {
  font-style: normal;
  font-weight: 400;
  font-size: 16px;
  line-height: 16px;
  margin-left: 16px;
}

.header-primary-item--icon {
  margin-left: 17px;
  margin-right: 0 !important;
}

.header-primary-item--registry .header-primary-item__title {
  font-size: 12px;
  line-height: normal;
  margin-left: 13px;
}

.header-secondary-menu {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  -webkit-box-pack: end;
  -ms-flex-pack: end;
  justify-content: end;
  visibility: visible;
  opacity: 1;
  -webkit-transition: 0.5s all ease-in-out;
  -o-transition: 0.5s all ease-in-out;
  transition: 0.5s all ease-in-out;
}

.header-secondary-menu.is-hidden {
  visibility: hidden;
  opacity: 0;
}

.header-secondary-menu__list {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  margin-right: 36px;
  -webkit-box-flex: 1;
  -ms-flex: auto 1 1;
  flex: auto 1 1;
  -webkit-box-pack: justify;
  -ms-flex-pack: justify;
  justify-content: space-between;
}

.header-secondary-menu__item {
  font-style: normal;
  font-weight: 500;
  font-size: 14px;
  line-height: 14px;
}

.header-dropdown-menu {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
}

.header-dropdown-menu__title {
  font: normal 500 16px/16px "Muller";
  margin-right: 3px;
}

.header-dropdown-menu__img-mobile {
  display: none;
}

.header-dropdown-menu__sticky {
  display: none;
}

.anchor {
  position: relative;
}

.anchor span {
  position: absolute;
  top: -150px;
}

.breadcrumbs {
  margin: 24px 0;
}

.breadcrumbs__list {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
}

.breadcrumbs__item {
  font-style: normal;
  font-weight: 400;
  font-size: 12px;
  line-height: 12px;
  color: #9CA0A6;
}

.breadcrumbs__item:has(.breadcrumbs__link) {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
}

.breadcrumbs__item:has(.breadcrumbs__link):after {
  content: "";
  display: inline-block;
  position: absolute;
  position: relative;
  content: "|";
  margin: 0 27px;
  font-style: normal;
  font-weight: 400;
  font-size: 11px;
  line-height: 11px;
  color: #CFD2D6;
}

.breadcrumbs__link {
  color: #717479;
}

.btn {
  font: normal 400 16px/19px "Inter";
  color: #D62459;
  border: 1px solid #D62459;
  border-radius: 30px;
  padding: 10px;
  width: 282px;
  height: 52px;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  -webkit-box-pack: center;
  -ms-flex-pack: center;
  justify-content: center;
  margin-bottom: 5px;
}

.btn[type=submit]:hover {
  opacity: 0.85;
}

.btn:hover {
  color: #D62459;
}

.btn-secondary {
  background: #D62459;
  color: #fff;
}

.btn-secondary--arrow {
  background: url(../img/other/right-arrow-white.svg) no-repeat 87% center #D62459 !important;
}

.btn-secondary:hover {
  color: #fff;
}

.btn:disabled {
  background: #828282 !important;
  border-color: #828282 !important;
}

.animated-button {
  position: relative;
  cursor: pointer;
  outline: none;
}

.animated-button::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 1px solid #D62459;
  outline: 1px solid #D62459;
  outline-offset: 4px;
  opacity: 0;
  -webkit-transition: opacity 0.6s ease;
  -o-transition: opacity 0.6s ease;
  transition: opacity 0.6s ease;
  border-radius: 30px;
}

.animated-button:hover::after {
  opacity: 0.5;
}

.filter__categories {
  border: 1px solid #E6E9EE;
  border-radius: 3px;
}

.filter__category {
  color: #30343C;
  font-size: 18px;
  font-style: normal;
  font-weight: 400;
  line-height: normal;
  padding: 15px 32px 15px 40px;
  border-bottom: 1px solid #E6E9EE;
  background: #FCFCFE;
  cursor: pointer;
  border-radius: 3px;
}

.filter__category:first-child {
  border-radius: 3px 3px 0 0;
}

.filter__category:last-child {
  border-bottom: none;
  border-radius: 0 0 3px 3px;
}

.filter__category:first-child,
.filter__category:last-child {
  border-radius: 3px;
}

.filter__category--active {
  border-bottom: 1px solid #0F88BA;
  background: #00A0E3;
  color: #FFF;
  font-weight: 500;
  position: relative;
}

.filter__category--active:after {
  background: url("../img/main/active-arrow.svg");
  content: "";
  width: 24px !important;
  height: 24px !important;
  position: absolute;
  right: 32px;
  top: 50%;
  -webkit-transform: translate(0, -50%) rotate(90deg);
  -ms-transform: translate(0, -50%) rotate(90deg);
  transform: translate(0, -50%) rotate(90deg);
  -webkit-filter: brightness(0) saturate(100%) invert(100%) sepia(100%) saturate(2%) hue-rotate(354deg) brightness(110%) contrast(101%);
  filter: brightness(0) saturate(100%) invert(100%) sepia(100%) saturate(2%) hue-rotate(354deg) brightness(110%) contrast(101%);
}

.filter__navigation {
  display: none;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  -webkit-box-pack: justify;
  -ms-flex-pack: justify;
  justify-content: space-between;
  margin: 20px 0;
}

.filter__button {
  cursor: pointer;
}

.filter__button-close {
  display: none;
}

.filter__title {
  display: none;
}

.filter__tab {
  border-radius: 3px !important;
  border: 1px solid #E6E9EE !important;
  background: #FCFCFE !important;
}

.filter__tab.is-active .filter__trigger {
  color: #000 !important;
}

.filter__tab.is-active .filter__trigger:after {
  background: url("../img/main/active-arrow.svg") !important;
}

.filter__trigger {
  color: #575D6D !important;
  font-size: 18px !important;
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: normal !important;
  padding: 22px 32px 21px 40px !important;
}

.filter__trigger:after {
  background: url("../img/main/arrow.svg") !important;
  content: "" !important;
  width: 24px !important;
  height: 24px !important;
  right: 32px !important;
}

.filter__body {
  padding: 1px 32px 24px 56px !important;
}

.filter__checkbox {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  gap: 8px;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  margin-bottom: 16px;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
  position: relative;
}

.filter__checkbox:last-child {
  margin-bottom: 0;
}

.filter__checkbox input[type=checkbox] {
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  width: 16px;
  height: 16px;
}

.filter__checkbox input[type=checkbox]:after {
  content: "";
  position: absolute;
  left: 0;
  top: 1px;
  width: 16px;
  height: 16px;
  border-radius: 3px;
  border: 1px solid #9FA1B9;
  background: #E3E5EE;
}

.filter__checkbox input[type=checkbox]:checked:after {
  background: url("../img/main/checkbox.svg") no-repeat center #E3E5EE;
}

.filter__checkbox input[type=checkbox]:checked + .filter__checkmark {
  color: #424447;
}

.filter__checkbox input[type=checkbox]:checked ~ .filter__checkbox:after {
  background: #ff0000;
}

.filter__checkmark {
  color: #6D7786;
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  line-height: 20px;
  margin-left: 8px;
  -webkit-transition: all 0.5s ease-in-out;
  -o-transition: all 0.5s ease-in-out;
  transition: all 0.5s ease-in-out;
}

.headline-promo__headline {
  font: normal 400 52px/68px "Tenor Sans";
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.headline-promo-btn {
  float: right;
  margin-top: 15px;
  margin-right: 4px;
}

.headline-promo-btn__icon {
  margin-left: 8px;
}

.headline-primary {
  margin-bottom: 28px;
}

.headline-primary__headline {
  font: normal 400 48px/60px "Tenor Sans";
  -webkit-transition: 0.3s all ease-in-out;
  -o-transition: 0.3s all ease-in-out;
  transition: 0.3s all ease-in-out;
}

.headline-primary--flex {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: justify;
  -ms-flex-pack: justify;
  justify-content: space-between;
  -webkit-box-align: end;
  -ms-flex-align: end;
  align-items: end;
}

.headline-primary--post {
  display: grid;
  grid-template-columns: 80%;
}

.headline-stars {
  -webkit-box-pack: start;
  -ms-flex-pack: start;
  justify-content: start;
  -webkit-column-gap: 50px;
  -moz-column-gap: 50px;
  column-gap: 50px;
  margin-bottom: 23px;
}

.headline-stars .resort-stars {
  margin-bottom: 10px;
}

.lead-form__container {
  background: #F8F5F0;
  -webkit-backdrop-filter: blur(12.5px);
  backdrop-filter: blur(12.5px);
  border-radius: 12px;
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 32px;
  padding-top: 64px;
  padding-bottom: 64px;
}

.lead-form__left {
  grid-column: 2/8;
  align-self: start;
}

.lead-form__title {
  font: normal 400 40px/55px "Tenor Sans";
  margin-bottom: 41px;
}

.lead-form__badge {
  color: #D62459;
  border-radius: 24px;
  border: 2px solid #D62459;
  padding: 0 15px 3px 15px;
}

.lead-form p {
  margin-bottom: 0 !important;
}

.lead-form__description {
  font-style: normal;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  color: #2E3136;
  padding-left: 37%;
}

.lead-form__description span {
  font-weight: 500;
  color: #131415;
}

.lead-form__description ul li {
  color: #534E4E;
  font-size: 14px;
  line-height: 21px;
  list-style: disc;
}

.lead-form__description ul li:not(:last-child) {
  margin-bottom: 5px;
}

.lead-form__right {
  grid-column: 8/12;
  align-self: end;
}

.lead-form__line {
  position: relative;
  margin-bottom: 24px;
}

.lead-form__line:has(input[type=text]):before,
.lead-form__line:has(input[type=date]):before,
.lead-form__line:has(select):before {
  background: url("../img/lead-form/user.svg");
  content: "";
  display: inline-block;
  position: absolute;
  left: 18px;
  top: 50%;
  width: 18px;
  height: 18px;
  -webkit-transform: translateY(-50%);
  -ms-transform: translateY(-50%);
  transform: translateY(-50%);
}

.lead-form__line--phone:before {
  background: url("../img/lead-form/phone.svg") !important;
}

.lead-form__line--email:before {
  background: url("../img/lead-form/mail.svg") !important;
}

.lead-form__line--calendar:before {
  background: url("../img/lead-form/calendar.svg") !important;
}

.lead-form__line--clients select {
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  background-position: calc(100% - 42px) center !important;
