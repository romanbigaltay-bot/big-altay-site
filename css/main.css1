.hover {
  -webkit-transition: all 0.1s ease;
  -o-transition: all 0.1s ease;
  transition: all 0.1s ease;
}

.hover:hover {
  color: #00A0E3;
  border-bottom: 1px solid #00A0E3;
  padding-bottom: 5px;
}

.menu-hamburger {
  position: fixed;
  display: block;
  width: 100%;
  height: 100%;
  top: -150%;
  left: 0;
  z-index: 99;
  background: #EDEDF2;
  -webkit-transition: top 1s ease-in-out;
  -o-transition: top 1s ease-in-out;
  transition: top 1s ease-in-out;
}

.menu-hamburger.is-active {
  top: 0;
  -webkit-transition: top 0.8s ease-in-out;
  -o-transition: top 0.8s ease-in-out;
  transition: top 0.8s ease-in-out;
  padding-top: 120px;
}

.menu-hamburger__container {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  height: 100%;
  -webkit-box-align: end;
  -ms-flex-align: end;
  align-items: end;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
  overflow: auto;
}

.menu-hamburger__container::-webkit-scrollbar {
  width: 8px;
}

.menu-hamburger__container::-webkit-scrollbar-thumb {
  background: #029fe5;
  border-radius: 20px;
  border: 2px solid #029fe5;
}

.menu-hamburger__container::-webkit-scrollbar-track {
  background: #ddd;
}

.menu-hamburger__close {
  font: 300 22px "Muller";
  -webkit-box-flex: 100%;
  -ms-flex: 100% 0 0px;
  flex: 100% 0 0;
  color: #000;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  -webkit-column-gap: 6px;
  -moz-column-gap: 6px;
  column-gap: 6px;
  -webkit-box-pack: end;
  -ms-flex-pack: end;
  justify-content: end;
  -ms-flex-item-align: start;
  align-self: start;
}

.menu-hamburger__close:after {
  background: url("../img/other/close.svg");
  content: "";
  display: inline-block;
  position: absolute;
  position: relative;
  width: 30px;
  height: 30px;
}

.menu-hamburger__wrapper {
  display: grid;
  gap: 32px;
  grid-template-columns: repeat(12, 1fr);
  height: 100%;
  padding-right: 10px;
}

.menu-hamburger__nav {
  grid-column: 1/7;
  margin-bottom: 40px;
  align-self: end;
  height: 85%;
}

.menu-hamburger__list {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
  gap: 20px 55px;
  height: 100%;
}

.menu-hamburger__item {
  font: 20px/24px "Tenor Sans";
  -webkit-box-flex: 45%;
  -ms-flex: 45% 0 0px;
  flex: 45% 0 0;
}

.menu-hamburger__right {
  grid-column: 8/13;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
  gap: 35px;
  height: 100%;
  padding-top: 10px;
}

.navigation {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-column-gap: 29px;
  -moz-column-gap: 29px;
  column-gap: 29px;
  position: relative;
  z-index: 9;
}

.navigation__next,
.navigation__prev {
  width: 75px;
  height: 32px;
  cursor: pointer;
}

.navigation__next:hover,
.navigation__prev:hover {
  -webkit-transition: 0.3s all ease-in-out;
  -o-transition: 0.3s all ease-in-out;
  transition: 0.3s all ease-in-out;
  -webkit-filter: brightness(0.5);
  filter: brightness(0.5);
}

.navigation__next:before,
.navigation__prev:before {
  content: "";
  width: 75px;
  height: 32px;
  display: -webkit-inline-box;
  display: -ms-inline-flexbox;
  display: inline-flex;
}

.navigation__next:before {
  background: url("../img/navigation/next-white.svg");
}

.navigation__prev:before {
  background: url("../img/navigation/prev-white.svg");
}

.navigation--gray .navigation__next:before {
  background: url("../img/navigation/next-gray.svg");
}

.navigation--gray .navigation__prev:before {
  background: url("../img/navigation/prev-gray.svg");
}

