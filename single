    <script>ymaps.ready(init);

        function init() {
            var myMap = new ymaps.Map("map", {
                center: [<?php the_field('sanatorium_coordinates'); ?>],
                zoom: 15,
                controls: []
            });
            var myGeoObjects = [];
            myGeoObjects = new ymaps.Placemark([<?php the_field('sanatorium_coordinates'); ?>], {balloonContentBody: '<?= the_title(); ?>',});
            var clusterer = new ymaps.Clusterer({clusterDisableClickZoom: false, clusterOpenBalloonOnClick: false,});
            clusterer.add(myGeoObjects);
            myMap.geoObjects.add(clusterer);
        }
    </script>

